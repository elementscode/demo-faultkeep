import "./style.css";
import { redirect } from "@elements/app";
import { signin, DEMO_LOGINS } from "#app/shared/services/auth";
import { Brand } from "#app/shared/templates/layout";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import favicon from "#app/shared/assets/favicons/favicon.svg";

interface SigninForm {
  email: string;
  password: string;
  error: string;
  busy: boolean;
}

function onSubmit(form: SigninForm) {
  form.busy = true;

  try {
    signin(form.email, form.password);
    form.error = "";
    redirect("/");
  } catch (err: any) {
    form.error = err.message;
    form.busy = false;
  }
}

function useLogin(form: SigninForm, email: string, password: string) {
  form.email = email;
  form.password = password;
  onSubmit(form);
}

<html lang="en" class="page-auth" (
  showDemo: boolean,
  private form: SigninForm = { email: "", password: "", error: "", busy: false },
)>
  <head>
    <title>Sign in · faultkeep</title>
    <meta name="description" content="Sign in to faultkeep, error tracking for web apps.">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <main class="auth-main center">
      <div class="auth-column stack is-lg">
        <div class="auth-head stack is-sm">
          <Brand size={30} />
          <p>Error tracking for web apps.</p>
        </div>

        <Card class="auth-card">
          <CardContent>
            <form class="stack" onsubmit={() => onSubmit(form)}>
              <h1>Sign in</h1>

              <Alert e:if={form.error} variant="danger" description={form.error} />

              <Field label="Email" required>
                <Input type="email"
                       name="email"
                       value={form.email}
                       placeholder="you@company.com"
                       attrs={{ autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
              </Field>

              <Field label="Password" required>
                <Input type="password"
                       name="password"
                       value={form.password}
                       attrs={{ autocomplete: "current-password" }} />
              </Field>

              <Button type="submit" variant="primary" block loading={form.busy}>Sign in</Button>
            </form>
          </CardContent>
        </Card>

        <Card e:if={showDemo} class="demo-logins">
          <CardContent class="stack is-sm">
            <p class="demo-title">Seeded demo logins</p>
            <div e:for={login of DEMO_LOGINS} class="demo-login row">
              <div class="demo-login-who">
                <strong>{login.name}</strong>
                <code>{login.email}</code> · <code>{login.password}</code>
              </div>
              <Button size="sm" onclick={() => useLogin(form, login.email, login.password)}>Sign in as {login.name.split(" ")[0]}</Button>
            </div>
          </CardContent>
        </Card>

        <p class="auth-alt">New here? <a href="/signup">Create an account</a></p>
      </div>
    </main>
  </body>
</html>
