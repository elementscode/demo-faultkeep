import "./style.css";
import { redirect } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import { Project, createProject } from "#app/shared/services/projects";
import { compact } from "#app/shared/lib/format";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Empty } from "@elements/ui/empty";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";

export interface ProjectSummary {
  id: string;
  name: string;
  unresolved: number;
  events24h: number;
  members: number;
}

interface NewProjectForm {
  name: string;
  error: string;
}

function onCreate(form: NewProjectForm) {
  try {
    let project = createProject(form.name);
    redirect(`/projects/${project.id}/settings`);
  } catch (err: any) {
    form.error = err.message;
  }
}

<html lang="en" class="page-projects" (
  projects: Project[],
  summaries: ProjectSummary[],
  private form: NewProjectForm = { name: "", error: "" },
)>
  <head>
    <title>Projects · faultkeep</title>
    <meta name="description" content="Your faultkeep projects">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout {projects} current={null} section="projects">
      <div class="stack is-xl">
        <div class="projects-head stack is-xs">
          <h1>Projects</h1>
          <p>Each project has its own DSN key and its own issues.</p>
        </div>

        <div e:if={summaries.length > 0} class="project-grid">
          <a e:for={p of summaries} class="project-link" href={`/projects/${p.id}`}>
            <Card title={p.name} level={2}>
              <CardContent>
                <div class="project-numbers">
                  <div class="project-number"><strong>{compact(p.unresolved)}</strong><span>unresolved</span></div>
                  <div class="project-number"><strong>{compact(p.events24h)}</strong><span>events, 24h</span></div>
                  <div class="project-number"><strong>{p.members}</strong><span>{p.members === 1 ? "member" : "members"}</span></div>
                </div>
              </CardContent>
            </Card>
          </a>
        </div>

        <Empty e:else variant="outline" title="No projects yet" description="You have no projects yet. Create one to get a DSN key." />

        <form class="project-new" onsubmit={() => onCreate(form)}>
          <Card>
            <CardContent class="stack is-sm">
              <Field label="New project" required>
                <div class="row">
                  <Input value={form.name} placeholder="Marketing site" />
                  <Button type="submit" variant="primary">Create</Button>
                </div>
              </Field>
              <Alert e:if={form.error} variant="danger" description={form.error} />
            </CardContent>
          </Card>
        </form>
      </div>
    </Layout>
  </body>
</html>
