import "./style.css";
import { redirect } from "@elements/app";
import { signup, MIN_PASSWORD } from "#app/shared/services/auth";
import { Brand } from "#app/shared/templates/layout";
import favicon from "#app/shared/assets/favicons/favicon.svg";

interface SignupForm {
  name: string;
  email: string;
  password: string;
  error: string;
  busy: boolean;
}

function onSubmit(form: SignupForm) {
  form.busy = true;

  try {
    signup(form.name, form.email, form.password);
    form.error = "";
    redirect("/projects");
  } catch (err: any) {
    form.error = err.message;
    form.busy = false;
  }
}

<html lang="en" class="page-auth" (
  private form: SignupForm = { name: "", email: "", password: "", error: "", busy: false },
)>
  <head>
    <title>Create an account · faultkeep</title>
    <meta name="description" content="Create a faultkeep account.">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <main class="auth-main center">
      <div class="auth-column stack is-lg">
        <div class="auth-head stack is-sm">
          <Brand size={30} />
          <p>Error tracking for web apps.</p>
        </div>

        <div class="card auth-card">
          <div class="card-body">
            <form class="stack" onsubmit={() => onSubmit(form)}>
              <h1>Create an account</h1>

              <div e:if={form.error} class="callout is-danger" role="alert">{form.error}</div>

              <div class="field">
                <label for="name">Name</label>
                <input id="name" name="name" value={form.name} autocomplete="name" required>
              </div>

              <div class="field">
                <label for="email">Email</label>
                <input id="email"
                       name="email"
                       type="email"
                       value={form.email}
                       autocomplete="email"
                       autocapitalize="none"
                       spellcheck={false}
                       placeholder="you@company.com"
                       required>
              </div>

              <div class="field">
                <label for="password">Password</label>
                <input id="password"
                       name="password"
                       type="password"
                       value={form.password}
                       autocomplete="new-password"
                       minlength={MIN_PASSWORD}
                       required>
                <p class="hint">At least {MIN_PASSWORD} characters.</p>
              </div>

              <button type="submit" class={["is-primary", "is-block", form.busy && "is-loading"]}>Create account</button>
            </form>
          </div>
        </div>

        <p class="auth-alt">Have an account? <a href="/signin">Sign in</a></p>
      </div>
    </main>
  </body>
</html>
