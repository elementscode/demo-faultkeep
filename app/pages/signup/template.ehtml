import "./style.css";
import { redirect } from "@elements/app";
import { signup, MIN_PASSWORD } from "#app/shared/services/auth";
import { Brand } from "#app/shared/templates/layout";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import favicon from "#app/shared/assets/favicons/favicon.svg";

interface SignupForm {
  name: string;
  email: string;
  password: string;
  error: string;
  busy: boolean;
}

function onSubmit(form: SignupForm) {
  form.busy = true;

  try {
    signup(form.name, form.email, form.password);
    form.error = "";
    redirect("/projects");
  } catch (err: any) {
    form.error = err.message;
    form.busy = false;
  }
}

<html lang="en" class="page-auth" (
  private form: SignupForm = { name: "", email: "", password: "", error: "", busy: false },
)>
  <head>
    <title>Create an account · faultkeep</title>
    <meta name="description" content="Create a faultkeep account.">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <main class="auth-main center">
      <div class="auth-column stack is-lg">
        <div class="auth-head stack is-sm">
          <Brand size={30} />
          <p>Error tracking for web apps.</p>
        </div>

        <Card class="auth-card">
          <CardContent>
            <form class="stack" onsubmit={() => onSubmit(form)}>
              <h1>Create an account</h1>

              <Alert e:if={form.error} variant="danger" description={form.error} />

              <Field label="Name" required>
                <Input name="name" value={form.name} attrs={{ autocomplete: "name" }} />
              </Field>

              <Field label="Email" required>
                <Input type="email"
                       name="email"
                       value={form.email}
                       placeholder="you@company.com"
                       attrs={{ autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
              </Field>

              <Field label="Password" description={`At least ${MIN_PASSWORD} characters.`} required>
                <Input type="password"
                       name="password"
                       value={form.password}
                       attrs={{ autocomplete: "new-password", minlength: MIN_PASSWORD }} />
              </Field>

              <Button type="submit" variant="primary" block loading={form.busy}>Create account</Button>
            </form>
          </CardContent>
        </Card>

        <p class="auth-alt">Have an account? <a href="/signin">Sign in</a></p>
      </div>
    </main>
  </body>
</html>
