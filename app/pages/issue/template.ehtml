import "./style.css";
import { LiveView } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import { Project, Member } from "#app/shared/services/projects";
import { Issue, IssueStatus, ErrorEvent, IssueTag, IssueBucket, setStatus, assign } from "#app/shared/services/issues";
import { timeAgo, compact, dateTime } from "#app/shared/lib/format";
import { parseStack } from "#app/shared/lib/stack";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import type { ChartConfig } from "@elements/ui/chart";
import { BarChart } from "@elements/ui/chart-bar";
import { Badge } from "@elements/ui/badge";
import { Breadcrumb, BreadcrumbItem, BreadcrumbLink, BreadcrumbPage, BreadcrumbSeparator } from "@elements/ui/breadcrumb";
import { Button } from "@elements/ui/button";
import { Card, CardAction, CardContent } from "@elements/ui/card";
import { NativeSelect } from "@elements/ui/native-select";
import { ToggleGroup, ToggleGroupItem } from "@elements/ui/toggle-group";

type Range = "24h" | "7d";

interface ViewState {
  range: Range;
  selectedId: string;
  raw: boolean;
}

interface Bin {
  id: string;
  label: string;
  total: number;
}

const HOUR = 60 * 60 * 1000;
const CHART: ChartConfig = {
  total: { label: "Events", color: "var(--accent)" },
};
const TAG_KEYS = [
  { id: "browser", label: "Browser" },
  { id: "os", label: "OS" },
  { id: "release", label: "Release" },
  { id: "url", label: "URL" },
];

function bins(buckets: LiveView<IssueBucket>, range: Range, now: Date): Bin[] {
  let size = range === "24h" ? HOUR : 6 * HOUR;
  let count = range === "24h" ? 24 : 28;
  let end = Math.floor(+now / HOUR) * HOUR + HOUR;
  let start = end - size * count;
  let out: Bin[] = [];

  for (let i = 0; i < count; i++) {
    let s = start + i * size;
    out.push({ id: String(s), label: binLabel(new Date(s), new Date(s + size), range), total: 0 });
  }

  for (let b of buckets) {
    let t = +b.bucketAt;
    if (t >= start && t < end) {
      out[Math.floor((t - start) / size)].total += b.total;
    }
  }

  return out;
}

function binLabel(start: Date, end: Date, range: Range): string {
  let day = start.toLocaleDateString(undefined, { weekday: "short", month: "short", day: "numeric" });
  let hour = (d: Date) => d.toLocaleTimeString(undefined, { hour: "numeric" });

  return range === "24h" ? `${day}, ${hour(start)}` : `${day}, ${hour(start)} to ${hour(end)}`;
}

/** The axis names every sixth hour for a day, and the bin each day starts in for a week. */
function ticks(rows: Bin[], range: Range): string[] {
  let day = (b: Bin) => new Date(+b.id).toDateString();

  return rows
    .filter((b, i) => range === "24h" ? new Date(+b.id).getHours() % 6 === 0 : i > 0 && day(b) !== day(rows[i - 1]))
    .map((b) => b.id);
}

function tick(id: string, range: Range): string {
  let d = new Date(+id);

  return range === "24h" ? d.toLocaleTimeString(undefined, { hour: "numeric" }) : d.toLocaleDateString(undefined, { weekday: "short" });
}

function tagValues(tags: LiveView<IssueTag>, key: string): { id: string; value: string; timesSeen: number; pct: number }[] {
  let rows = tags.filter((t) => t.key === key).sort((a, b) => b.timesSeen - a.timesSeen);
  let total = rows.reduce((n, t) => n + t.timesSeen, 0) || 1;

  return rows.slice(0, 5).map((t) => ({ id: t.id, value: t.value, timesSeen: t.timesSeen, pct: Math.round((t.timesSeen / total) * 100) }));
}

function splitTitle(title: string): { type: string; rest: string } {
  let m = title.match(/^([A-Za-z_$][\w$]*):\s(.*)$/s);

  return m ? { type: m[1], rest: m[2] } : { type: "", rest: title };
}

function selected(events: LiveView<ErrorEvent>, state: ViewState): ErrorEvent | undefined {
  return events.find((e) => e.id === state.selectedId) ?? events.at(0);
}

function onStatus(view: LiveView<Issue>, issue: Issue, status: IssueStatus) {
  setStatus(view, issue, status);
}

function onAssign(view: LiveView<Issue>, issue: Issue, e: Event) {
  let value = (e.target as HTMLSelectElement).value;
  assign(view, issue, value || null);
}

function onRange(state: ViewState, value: string) {
  if (value) {
    state.range = value as Range;
  }
}

function onTick(now: { value: Date }) {
  now.value = new Date();
}

<html lang="en" class="page-issue" (
  project: Project,
  projects: Project[],
  members: Member[],
  issueView: LiveView<Issue>,
  events: LiveView<ErrorEvent>,
  tags: LiveView<IssueTag>,
  buckets: LiveView<IssueBucket>,
  private state: ViewState = { range: "7d", selectedId: "", raw: false } as ViewState,
  private now: { value: Date } = { value: new Date() },
) oninit={() => setInterval(() => onTick(now), 1000)}>
  <head>
    <title>{issueView.at(0)?.title ?? "Issue"} · faultkeep</title>
    <meta name="description" content="Issue detail">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout {projects} current={project} section="issues">
      <div e:for={issue of issueView} class="stack is-lg">
        <Breadcrumb>
          <BreadcrumbItem><BreadcrumbLink href={`/projects/${project.id}`}>{project.name}</BreadcrumbLink></BreadcrumbItem>
          <BreadcrumbSeparator />
          <BreadcrumbItem><BreadcrumbPage>Issue</BreadcrumbPage></BreadcrumbItem>
        </Breadcrumb>

        <div class="issue-head row">
          <div class="issue-head-main stack is-sm">
            <h1 class="issue-h1">
              <span e:if={splitTitle(issue.title).type} class="issue-type">{splitTitle(issue.title).type}: </span>{splitTitle(issue.title).rest}
            </h1>
            <div class="cluster is-sm">
              <Badge e:if={issue.status === "unresolved"} variant="danger" dot>Unresolved</Badge>
              <Badge e:if={issue.status === "resolved"} variant="success" dot>Resolved {timeAgo(issue.resolvedAt, now.value)}</Badge>
              <Badge e:if={issue.status === "ignored"} variant="outline" dot>Ignored</Badge>
              <Badge e:if={issue.status === "unresolved" && issue.regressedAt} variant="warning">Regressed {timeAgo(issue.regressedAt, now.value)}</Badge>
              <span e:if={issue.culprit} class="issue-culprit">{issue.culprit}</span>
            </div>
          </div>

          <div class="issue-actions row">
            <NativeSelect size="sm" class="issue-assign" value={issue.assigneeId ?? ""} attrs={{ "aria-label": "Assignee" }} onchange={(e) => onAssign(issueView, issue, e)}>
              <option value="">Unassigned</option>
              <option e:for={m of members} value={m.id}>{m.name}</option>
            </NativeSelect>
            <Button e:if={issue.status !== "resolved"} variant="primary" size="sm" onclick={() => onStatus(issueView, issue, "resolved")}>Resolve</Button>
            <Button e:if={issue.status === "unresolved"} size="sm" onclick={() => onStatus(issueView, issue, "ignored")}>Ignore</Button>
            <Button e:if={issue.status !== "unresolved"} size="sm" onclick={() => onStatus(issueView, issue, "unresolved")}>Reopen</Button>
          </div>
        </div>

        <div class="stat-tiles">
          <div class="stat-tile">
            <div class="stat-tile-label">Events</div>
            <div class="stat-tile-value">{compact(issue.eventCount)}</div>
          </div>
          <div class="stat-tile">
            <div class="stat-tile-label">Users affected</div>
            <div class="stat-tile-value">{compact(issue.userCount)}</div>
          </div>
          <div class="stat-tile">
            <div class="stat-tile-label">First seen</div>
            <div class="stat-tile-value">{timeAgo(issue.firstSeen, now.value)}</div>
            <div class="stat-tile-note">{dateTime(issue.firstSeen)}</div>
          </div>
          <div class="stat-tile">
            <div class="stat-tile-label">Last seen</div>
            <div class="stat-tile-value">{timeAgo(issue.lastSeen, now.value)}</div>
            <div class="stat-tile-note">{dateTime(issue.lastSeen)}</div>
          </div>
        </div>

        <div class="detail-grid">
          <div class="stack is-lg">
            <Card title="Events over time" level={2}>
              <CardAction slot="action">
                <ToggleGroup value={state.range} variant="outline" size="sm" spacing={0} label="Time range" onValueChange={(v) => onRange(state, v)}>
                  <ToggleGroupItem value="24h">24 hours</ToggleGroupItem>
                  <ToggleGroupItem value="7d">7 days</ToggleGroupItem>
                </ToggleGroup>
              </CardAction>
              <CardContent>
                <BarChart data={bins(buckets, state.range, now.value)}
                          config={CHART}
                          x="id"
                          class="event-chart"
                          label={`Events per ${state.range === "24h" ? "hour" : "6 hours"}`}
                          valueAxis={{ allowDecimals: false, tickCount: 3 }}
                          categoryAxis={{ ticks: ticks(bins(buckets, state.range, now.value), state.range), tickFormatter: (v) => tick(String(v), state.range) }}
                          tooltip={{ labelFormatter: (_label, row) => String(row.label) }} />
              </CardContent>
            </Card>

            <Card title="Stack trace" level={2}>
              <CardAction slot="action">
                <Button e:if={selected(events, state)} variant="ghost" size="sm" onclick={() => state.raw = !state.raw}>{state.raw ? "Frames" : "Raw"}</Button>
              </CardAction>
              <CardContent e:if={selected(events, state)} class="stack">
                <div class="event-context cluster">
                  <Badge variant="outline">{dateTime(selected(events, state)!.createdAt)}</Badge>
                  <Badge e:if={selected(events, state)!.release} variant="outline">{selected(events, state)!.release}</Badge>
                  <Badge e:if={selected(events, state)!.browser} variant="outline">{selected(events, state)!.browser}</Badge>
                  <Badge e:if={selected(events, state)!.os} variant="outline">{selected(events, state)!.os}</Badge>
                  <Badge e:if={selected(events, state)!.userKey} variant="outline">user {selected(events, state)!.userKey}</Badge>
                </div>
                <code class="event-url">{selected(events, state)!.url}</code>
                <pre e:if={state.raw || parseStack(selected(events, state)!.stack).length === 0} class="stack-raw">{selected(events, state)!.stack || selected(events, state)!.message}</pre>
                <ol e:else class="stack-frames">
                  <li e:for={frame of parseStack(selected(events, state)!.stack)}
                      class={[frame.id === "0" && "is-top", frame.lib && "is-lib"]}>
                    <span class="frame-file"><span class="frame-fn">{frame.fn}</span> {frame.file}</span>
                    <span e:if={frame.line !== null} class="frame-loc">{frame.line}:{frame.col}</span>
                  </li>
                </ol>
              </CardContent>
              <CardContent e:else>No events loaded.</CardContent>
            </Card>

            <Card title="Latest events" level={2}>
              <CardAction slot="action"><span class="text-sm text-ink-dim">Newest first</span></CardAction>
              <ul class="event-list">
                <li e:for={ev of events}>
                  <button class={["event-row", selected(events, state)?.id === ev.id && "is-selected", +now.value - +ev.createdAt < 3000 && "is-fresh"]}
                          onclick={() => state.selectedId = ev.id}>
                    <span class="event-when" title={dateTime(ev.createdAt)}>{timeAgo(ev.createdAt, now.value)}</span>
                    <span class="event-url">{ev.url.replace(/^https?:\/\/[^/]+/, "") || ev.url}</span>
                    <span class="event-browser">{[ev.browser, ev.os].filter(Boolean).join(" · ")}</span>
                    <span class="event-user">{ev.userKey || "anonymous"}</span>
                  </button>
                </li>
              </ul>
              <div e:if={events.hasMore} class="event-more">
                <Button variant="ghost" size="sm" onclick={() => events.more()}>Load older events</Button>
              </div>
            </Card>
          </div>

          <Card title="Tags" level={2}>
            <CardContent>
              <div e:for={key of TAG_KEYS} class="tag-group">
                <div class="tag-key row"><span>{key.label}</span></div>
                <div e:for={t of tagValues(tags, key.id)} class="tag-value" title={`${t.value}: ${t.timesSeen} events`}>
                  <span class="tag-fill" style={`width: ${t.pct}%`}></span>
                  <span class="tag-name">{t.value}</span>
                  <span class="tag-pct">{t.pct}%</span>
                </div>
                <div e:if={tagValues(tags, key.id).length === 0} class="text-sm text-ink-dim">None reported</div>
              </div>
            </CardContent>
          </Card>
        </div>
      </div>
    </Layout>
  </body>
</html>
